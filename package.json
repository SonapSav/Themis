  "license": "MIT",
  "type": "module",
  "description": "Themis — an OSCOLA legal citation manager",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
